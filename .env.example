# Copy to .env and fill in secrets:
#   cp .env.example .env
# NOTE: if this file was ever shared or committed with real values,
# rotate those secrets (HF token, WORKER_TOKEN).

# Hugging Face token (optional for public models; required for gated models)
HF_TOKEN=

# ============================ API authentication ============================

# Long-lived API key for external clients (Authorization: Bearer <key>).
# Required for /v1/*, POST /jobs, GET /jobs/{id}, GET /queue/metrics.
# Leave empty to disable API-key auth (development mode; do NOT do this on
# an exposed port). Never commit a real key.
API_KEY=

# ============================ Model backend ============================

# llama_cpp (recommended: GGUF + llama-server, native Windows, CPU-optimized)
#   | transformers (legacy FLAN pipeline — rollback path)
LLM_BACKEND=llama_cpp

# Model id reported by /v1/models and in every response "model" field
LLM_MODEL=Qwen3-1.7B-Q4_K_M

# Path to the GGUF file used when LLM_BACKEND=llama_cpp (relative to repo root)
LLM_MODEL_PATH=models/gguf/Qwen3-1.7B-Q4_K_M.gguf

# Public API port. Native runs read LLM_PORT (VLLM_PORT is accepted as an alias;
# docker-compose.yml maps the host port with VLLM_PORT)
LLM_PORT=8000

# ---- llama.cpp backend ----
# Internal llama-server port (bound to 127.0.0.1 only)
LLM_BACKEND_PORT=8100
# Context window (tokens)
LLM_CONTEXT_SIZE=8192
# CPU threads (0 = auto). 4 is optimal on the 4C/8T test machine
LLM_THREADS=4
# Server-wide default for hybrid reasoning models: auto | on | off
LLM_THINKING=auto
# Put chain-of-thought in message.reasoning_content, final answer in content
LLM_REASONING_FORMAT=deepseek
# Optional token budget for thinking (llama-server --reasoning-budget)
# LLM_REASONING_BUDGET=1024
# max_tokens default when a request omits it / hard cap
# (reasoning models spend part of the budget on thinking — 1024 leaves room
# for a real answer; raise toward LLM_MAX_TOKENS_CAP for long reasoning)
LLM_MAX_TOKENS=1024
LLM_MAX_TOKENS_CAP=4096
# Extra flags appended to llama-server, e.g. "--flash-attn off"
# LLM_EXTRA_ARGS=
# LLM_STARTUP_TIMEOUT=180
# LLM_REQUEST_TIMEOUT=600
# LLM_LOG=logs/llama-server.log

# ---- transformers backend (legacy) ----
TRANSFORMERS_MODEL=google/flan-t5-small

# ==================== Docker (optional) ====================
# Service started by run.sh --docker: llama_cpp (default) | transformers | vllm.
# Native runs (no --docker) ignore this variable.
RUN_BACKEND=llama_cpp

# vLLM backend — model id or HuggingFaceRepo:alias (see vLLM docs)
VLLM_MODELS=google/flan-t5-small:flan-t5-small

# Quantization (vLLM; e.g. int8 when supported)
VLLM_QUANTIZATION=int8

# Preload models into VRAM at startup (false is safer on small GPUs)
VLLM_LOAD_ON_START=false

# Device: cpu | cuda
VLLM_DEVICE=cpu

# GPU index(es), e.g. 0 or 0,1 (leave empty for CPU)
CUDA_VISIBLE_DEVICES=

# Host port for the transformers/vllm compose services (also read by server.py
# as an alias of LLM_PORT). The llama_cpp service publishes LLM_PORT instead.
VLLM_PORT=8000

# ================= Reverse-webhook queue & LAN worker (optional) =================

# Shared secret for worker endpoints (/jobs/next, /workers/heartbeat)
WORKER_TOKEN=change-me

# Cloud API: no worker poll within this window → circuit opens
POLL_STALE_SEC=15

# Job lease handed to worker (seconds)
LEASE_SEC=30

# Oldest queued job age before circuit opens (seconds)
QUEUE_AGE_SLA_SEC=10

# Queue depth before circuit opens
QUEUE_DEPTH_LIMIT=100

# Consecutive failures before circuit opens
FAIL_OPEN_THRESHOLD=3

# Cooldown before probing local again (seconds)
HALF_OPEN_COOLDOWN_SEC=30

# LAN worker: public API base URL (worker.sh)
API_BASE=http://127.0.0.1:8000

# LAN worker: local model server on the worker machine
LOCAL_MODEL_BASE=http://localhost:8000

# Worker polling / HTTP tuning (worker.sh)
POLL_DELAY_MS=800
HEARTBEAT_SEC=10
TIMEOUT_SEC=60
