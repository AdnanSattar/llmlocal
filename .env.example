# Copy to .env and fill in secrets:
#   cp .env.example .env

# Hugging Face token (optional for public models; required for some gated models)
HF_TOKEN=

# Backend: transformers (CPU, default) | vllm (GPU when available)
RUN_BACKEND=transformers

# Transformers backend (CPU)
TRANSFORMERS_MODEL=google/flan-t5-small

# vLLM backend — model id or HuggingFaceRepo:alias (see vLLM docs)
# VLLM_MODEL=Qwen/Qwen3-0.6B
VLLM_MODELS=google/flan-t5-small:flan-t5-small

# Quantization (vLLM; e.g. int8 when supported)
VLLM_QUANTIZATION=int8

# Preload models into VRAM at startup (false is safer on small GPUs)
VLLM_LOAD_ON_START=false

# Device: cpu | cuda
VLLM_DEVICE=cpu

# GPU index(es), e.g. 0 or 0,1 (leave empty for CPU)
CUDA_VISIBLE_DEVICES=

# API port (host)
VLLM_PORT=8000

# ================= Reverse-webhook queue & LAN worker (optional) =================

# Shared secret for worker endpoints (/jobs/next, /workers/heartbeat)
WORKER_TOKEN=change-me

# Cloud API: no worker poll within this window → circuit opens
POLL_STALE_SEC=15

# Job lease handed to worker (seconds)
LEASE_SEC=30

# Oldest queued job age before circuit opens (seconds)
QUEUE_AGE_SLA_SEC=10

# Queue depth before circuit opens
QUEUE_DEPTH_LIMIT=100

# Consecutive failures before circuit opens
FAIL_OPEN_THRESHOLD=3

# Cooldown before probing local again (seconds)
HALF_OPEN_COOLDOWN_SEC=30

# LAN worker: public API base URL (worker.sh)
API_BASE=http://127.0.0.1:8000

# LAN worker: local model server on the worker machine
LOCAL_MODEL_BASE=http://localhost:8000

# Worker polling / HTTP tuning (worker.sh)
POLL_DELAY_MS=800
HEARTBEAT_SEC=10
TIMEOUT_SEC=60
