        {
          "name": "GET /v1/models — no API key (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_base_url}}/models", "host": [ "{{api_base_url}}" ], "path": [ "models" ] },
            "description": "Deliberately sent without Authorization (noauth overrides the collection bearer auth). Expected 401 `invalid_api_key` when API_KEY is set — in dev mode (API_KEY empty) this returns 200 instead, so the test only asserts when a key is configured."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('401 when auth enabled', () => { const key = pm.environment.get('api_key') || pm.collectionVariables.get('api_key'); if (key) { pm.response.to.have.status(401); } });" ] } }
          ]
        }
      ]
    }
  ]
