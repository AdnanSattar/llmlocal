            "description": "Lists the served model. Inherits the collection bearer auth (Authorization: Bearer {{api_key}}); public only when API_KEY is unset (dev mode)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Valid JSON', () => pm.response.to.be.json);", "const body = pm.response.json();", "pm.test('object is \"list\"', () => pm.expect(body.object).to.eql('list'));", "pm.test('data is an array', () => pm.expect(body.data).to.be.an('array'));", "pm.test('at least one model returned', () => pm.expect(body.data).to.have.lengthOf.above(0));", "pm.test('model entry well-formed', () => { const m = body.data[0]; pm.expect(m.id).to.be.a('string').and.have.lengthOf.above(0); pm.expect(m.object).to.eql('model'); pm.expect(m.owned_by).to.eql('llmlocal'); });", "pm.test('id matches configured model (when set)', () => { const expected = pm.variables.get('model'); if (expected) { pm.expect(body.data.map(m => m.id)).to.include(expected); } });" ] } }
          ]
        }
      ]
