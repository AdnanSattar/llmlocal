    {
      "name": "Chat & Completions",
      "item": [
        {
          "name": "POST /v1/completions (basic)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{model}}\",\n  \"prompt\": \"Explain what an API is.\",\n  \"max_tokens\": 60,\n  \"temperature\": 0.5\n}" },
            "url": { "raw": "{{api_base_url}}/completions", "host": [ "{{api_base_url}}" ], "path": [ "completions" ] },
            "description": "Basic text completion. `model` is informational — the response echoes the configured model."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('object is text_completion', () => pm.expect(pm.response.json().object).to.eql('text_completion'));", "pm.test('Has choices', () => pm.expect(pm.response.json()).to.have.property('choices').that.is.an('array'));" ] } }
          ]
        },
        {
          "name": "POST /v1/completions (advanced params)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{model}}\",\n  \"prompt\": \"List three benefits of unit testing:\",\n  \"max_tokens\": 80,\n  \"temperature\": 0.4,\n  \"top_p\": 0.95,\n  \"stop\": [\"\\n\", \"User:\"]\n}" },
            "url": { "raw": "{{api_base_url}}/completions", "host": [ "{{api_base_url}}" ], "path": [ "completions" ] },
            "description": "temperature / top_p / stop-sequence sampling controls."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has usage', () => pm.expect(pm.response.json()).to.have.property('usage'));", "pm.test('Has choice text', () => pm.expect(pm.response.json().choices[0]).to.have.property('text'));" ] } }
          ]
        },
        {
          "name": "POST /v1/chat/completions (system prompt)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a helpful assistant that responds briefly and clearly.\" },\n    { \"role\": \"user\", \"content\": \"What is an API?\" }\n  ],\n  \"max_tokens\": 80,\n  \"temperature\": 0.3\n}" },
            "url": { "raw": "{{api_base_url}}/chat/completions", "host": [ "{{api_base_url}}" ], "path": [ "chat", "completions" ] },
            "description": "Chat completion with a system prompt. On a hybrid reasoning model the default thinking mode consumes part of max_tokens — raise it or add \"thinking\": false if content comes back empty."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('object is chat.completion', () => pm.expect(pm.response.json().object).to.eql('chat.completion'));", "pm.test('Assistant reply', () => pm.expect(pm.response.json().choices[0].message.role).to.eql('assistant'));", "pm.test('Has content property', () => pm.expect(pm.response.json().choices[0].message).to.have.property('content'));" ] } }
          ]
        },
        {
          "name": "POST /v1/chat/completions (multi-turn)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
