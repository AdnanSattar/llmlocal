    {
      "name": "Jobs & Queue",
      "description": "Async job queue. Enqueue with the API key, drain with the WORKER_TOKEN (a separate auth world — the API key is NOT accepted there), finish via webhook, then read status/metrics.",
      "item": [
        {
          "name": "POST /jobs (enqueue)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"Say ok.\",\n  \"max_tokens\": 16\n}" },
            "url": { "raw": "{{base_url}}/jobs", "host": [ "{{base_url}}" ], "path": [ "jobs" ] },
            "description": "The body is stored verbatim as the job payload (delivered to workers via /jobs/next). Inherits collection API-key auth. Saves the returned id into the `job_id` variable for the requests below."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has job_id', () => pm.expect(pm.response.json()).to.have.property('job_id'));", "pm.collectionVariables.set('job_id', pm.response.json().job_id);" ] } }
          ]
        },
        {
          "name": "POST /jobs/next (worker drain)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/jobs/next?worker_token={{worker_token}}", "host": [ "{{base_url}}" ], "path": [ "jobs", "next" ], "query": [ { "key": "worker_token", "value": "{{worker_token}}" } ] },
            "description": "Worker long-poll (up to 25 s when the queue is empty). Auth: WORKER_TOKEN query param only — sends NO Authorization header (a Bearer header here is ignored; the two auth worlds are independent)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has job key', () => pm.expect(pm.response.json()).to.have.property('job'));" ] } }
          ]
        },
        {
          "name": "POST /webhooks/completions (job result)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"result\": \"postman-ok\",\n  \"success\": true\n}" },
            "url": { "raw": "{{base_url}}/webhooks/completions", "host": [ "{{base_url}}" ], "path": [ "webhooks", "completions" ] },
            "description": "Worker posts the finished result. No auth (current documented behavior) — the unguessable job UUID is the capability. Run 'Enqueue job' first so {{job_id}} is set."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('ok true', () => pm.expect(pm.response.json().ok).to.eql(true));" ] } }
          ]
        },
        {
          "name": "GET /jobs/{job_id} (status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/jobs/{{job_id}}", "host": [ "{{base_url}}" ], "path": [ "jobs", "{{job_id}}" ] },
            "description": "Job status/result — should read `completed` after the webhook above. Inherits collection API-key auth."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Status completed', () => pm.expect(pm.response.json().status).to.eql('completed'));" ] } }
          ]
        },
        {
          "name": "POST /workers/heartbeat (worker liveness)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/workers/heartbeat?worker_token={{worker_token}}", "host": [ "{{base_url}}" ], "path": [ "workers", "heartbeat" ], "query": [ { "key": "worker_token", "value": "{{worker_token}}" } ] },
            "description": "Worker heartbeat. Auth: WORKER_TOKEN query param only (no Authorization header) — same independent auth world as /jobs/next. Returns the breaker state."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has breaker_state', () => pm.expect(pm.response.json()).to.have.property('breaker_state'));" ] } }
          ]
        },
        {
          "name": "GET /queue/metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/queue/metrics", "host": [ "{{base_url}}" ], "path": [ "queue", "metrics" ] },
            "description": "Queue depth / breaker state. Inherits collection API-key auth."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has queue_depth', () => pm.expect(pm.response.json()).to.have.property('queue_depth'));" ] } }
          ]
        }
      ]
    },
