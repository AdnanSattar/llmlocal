        {
          "name": "POST /v1/chat/completions (stream: true)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Count from 1 to 10.\" }\n  ],\n  \"max_tokens\": 64,\n  \"stream\": true\n}" },
            "url": { "raw": "{{api_base_url}}/chat/completions", "host": [ "{{api_base_url}}" ], "path": [ "chat", "completions" ] },
            "description": "Server-Sent Events stream (text/event-stream). Inspect the raw body — chunks are `data: {...}` lines ending with `data: [DONE]`; do NOT parse it as a single JSON document."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [ "pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Content-Type is SSE', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('text/event-stream'));", "pm.test('SSE chunks + terminator', () => { const t = pm.response.text(); pm.expect(t).to.include('data:'); pm.expect(t).to.include('data: [DONE]'); });" ] } }
          ]
        }
      ]
