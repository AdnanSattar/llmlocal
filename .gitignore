# Docker build marker (run.sh)
.docker_built

# Downloaded / cached Hugging Face models (mounted at ./models)
models/

# Downloaded runtimes (llama.cpp release zips/binaries)
tools/

# Runtime logs
logs/

# Secrets and local config (use .env.example as a template if you add one)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
.venv/
venv/
env/

# Python tooling caches / build artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg-info/
.eggs/
build/
dist/

# Logs and local runtime
*.log
*.pid

# Benchmark run scratch (keep the *.json result files; ignore raw logs/streams)
benchmarks/results/**/*.err
benchmarks/results/**/*.out
benchmarks/results/**/*.log
benchmarks/results/**/*.pid

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
